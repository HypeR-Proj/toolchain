#!/bin/sh
# SPDX-FileCopyrightText: 2026 roolrz
# SPDX-License-Identifier: Apache-2.0

# Build one Rust Native application exclusively against an assembled HypeR SDK.
set -eu

script_directory=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
default_sysroot=$(CDPATH='' cd -- "$script_directory/.." && pwd)
architecture=${HYPER_ARCH:-aarch64}
sysroot=${HYPER_SYSROOT:-$default_sysroot}
cargo=${HYPER_CARGO_DRIVER:-cargo}
link_mode=${HYPER_LINK_MODE:-dynamic}

if [ "$#" -eq 0 ]; then
    echo "usage: hyper-cargo {build|check|clippy|generate-lockfile|rustc} [ARGUMENT ...]" >&2
    exit 2
fi
subcommand=$1
shift
case "$subcommand" in
    build | check | clippy | generate-lockfile | rustc) ;;
    *)
        echo "hyper-cargo: unsupported Cargo subcommand: $subcommand" >&2
        exit 2
        ;;
esac
for argument in "$@"; do
    case "$argument" in
        --target | --target=*)
            echo "hyper-cargo: the Native target is selected by HYPER_ARCH" >&2
            exit 2
            ;;
    esac
done

case "$architecture" in
    aarch64)
        target=aarch64-unknown-none
        target_table=target.aarch64-unknown-none
        ;;
    *)
        echo "hyper-cargo: unsupported Native architecture: $architecture" >&2
        exit 2
        ;;
esac
case "$link_mode" in
    dynamic)
        link_mode_rustflags=
        ;;
    static)
        # Make the selection part of Cargo's compiler fingerprint as well as
        # the final linker's environment. This forces a relink when one target
        # directory is reused across dynamic and static builds.
        link_mode_rustflags=", '-C', 'link-arg=-static'"
        ;;
    *)
        echo "hyper-cargo: HYPER_LINK_MODE must be dynamic or static" >&2
        exit 2
        ;;
esac

# Cargo resolves linker paths from the application workspace. Normalize the
# SDK root once so invocation location cannot change the selected toolchain.
if [ ! -d "$sysroot" ]; then
    echo "hyper-cargo: Native SDK directory does not exist: $sysroot" >&2
    exit 2
fi
sysroot=$(CDPATH='' cd -- "$sysroot" && pwd)
rust_sdk=$sysroot/share/hyper/rust
for required in \
    "$sysroot/bin/hyper-clang" \
    "$sysroot/share/hyper/abi/Cargo.toml" \
    "$rust_sdk/hyper-os/Cargo.toml" \
    "$rust_sdk/hyper-rt/Cargo.toml" \
    "$rust_sdk/hyper-service/Cargo.toml" \
    "$rust_sdk/hyper-vm-image/Cargo.toml" \
    "$rust_sdk/hyper-sys/Cargo.toml"; do
    if [ ! -f "$required" ]; then
        echo "hyper-cargo: incomplete Native Rust SDK: $required" >&2
        exit 2
    fi
done

# Cargo's command-line configuration uses TOML literal strings. Reject the two
# byte classes that could escape a generated path instead of constructing an
# ambiguous configuration.
case "$sysroot" in
    *"'"* | *"
"*)
        echo "hyper-cargo: SDK path contains an unsupported character" >&2
        exit 2
        ;;
esac

export HYPER_ARCH="$architecture"
export HYPER_SYSROOT="$sysroot"

if [ "$subcommand" = generate-lockfile ]; then
    exec "$cargo" \
        "$subcommand" \
        --config "patch.crates-io.hyper-abi.path = '$sysroot/share/hyper/abi'" \
        --config "patch.crates-io.hyper-os.path = '$rust_sdk/hyper-os'" \
        --config "patch.crates-io.hyper-rt.path = '$rust_sdk/hyper-rt'" \
        --config "patch.crates-io.hyper-service.path = '$rust_sdk/hyper-service'" \
        --config "patch.crates-io.hyper-vm-image.path = '$rust_sdk/hyper-vm-image'" \
        --config "patch.crates-io.hyper-sys.path = '$rust_sdk/hyper-sys'" \
        "$@"
fi

# The distributed bare-metal core/alloc rlibs are not built for Native PIE.
# Rebuild them with the same PIC/abort flags as the application. Scope Cargo's
# unstable build-std opt-in to this driver; the repository pins rustc + rust-src.
export RUSTC_BOOTSTRAP=1
exec "$cargo" \
    "$subcommand" -Z build-std=core,alloc \
    --config "$target_table.linker = '$sysroot/bin/hyper-clang'" \
    --config "$target_table.rustflags = ['-C', 'linker-flavor=gcc', '-C', 'relocation-model=pic', '-C', 'panic=abort'$link_mode_rustflags]" \
    --config "patch.crates-io.hyper-abi.path = '$sysroot/share/hyper/abi'" \
    --config "patch.crates-io.hyper-os.path = '$rust_sdk/hyper-os'" \
    --config "patch.crates-io.hyper-rt.path = '$rust_sdk/hyper-rt'" \
    --config "patch.crates-io.hyper-service.path = '$rust_sdk/hyper-service'" \
    --config "patch.crates-io.hyper-vm-image.path = '$rust_sdk/hyper-vm-image'" \
    --config "patch.crates-io.hyper-sys.path = '$rust_sdk/hyper-sys'" \
    --target "$target" \
    "$@"
