#!/bin/sh
# SPDX-FileCopyrightText: 2026 roolrz
# SPDX-License-Identifier: Apache-2.0

set -eu

script_directory=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
default_sysroot=$(CDPATH='' cd -- "$script_directory/.." && pwd)
compiler=${HYPER_CLANG:-clang}
sysroot=${HYPER_SYSROOT:-$default_sysroot}
manifest=$sysroot/share/hyper/manifest
architecture=$(sed -n 's/^architecture=//p' "$manifest")
case "$architecture" in aarch64|riscv64) ;; *)
    echo "hyper-clang: invalid SDK architecture identity" >&2; exit 2 ;;
esac
if [ "${HYPER_ARCH:-$architecture}" != "$architecture" ]; then
    echo "hyper-clang: HYPER_ARCH conflicts with the installed SDK" >&2
    exit 2
fi
linking=true
link_mode=${HYPER_LINK_MODE:-dynamic}
output_kind=executable
output=a.out
expect_output=false

for argument in "$@"; do
    if [ "$expect_output" = true ]; then
        output=$argument
        expect_output=false
        continue
    fi
    case "$argument" in
        -c|-E|-S|-M|-MM)
            linking=false
            ;;
        -static)
            link_mode=static
            ;;
        -shared)
            output_kind=shared
            ;;
        -o)
            expect_output=true
            ;;
        -o?*)
            output=${argument#-o}
            ;;
    esac
done
if [ "$expect_output" = true ]; then
    echo "hyper-clang: -o requires a path" >&2
    exit 2
fi

# Cargo exports the owning manifest directory to rustc and its linker. Enforce
# the bootstrap boundary here as well as in Make, including direct hyper-cargo
# builds. Resolve symlinks/parent components before classifying the source.
source_directory=${CARGO_MANIFEST_DIR:-$PWD}
source_directory=$(CDPATH='' cd -- "$source_directory" && pwd -P)
static_only=false
case "$source_directory/" in
    */bootstrap/stage1/*) static_only=true ;;
esac
if [ "$linking" = true ] && [ "$static_only" = true ]; then
    if [ "$link_mode" != static ] || [ "$output_kind" != executable ]; then
        echo "hyper-clang: bootstrap/stage1 only permits static executables; use HYPER_LINK_MODE=static (or make app-boot)" >&2
        exit 2
    fi
fi

case "$architecture" in
    aarch64)
        target=aarch64-none-elf
        architecture_flags=
        architecture_link_flags=
        ;;
    riscv64)
        target=riscv64-none-elf
        architecture_flags="-march=rv64gc -mabi=lp64d -mno-relax"
        architecture_link_flags=-Wl,--no-relax
        ;;
    *)
        echo "hyper-clang: unsupported Native architecture: $architecture" >&2
        exit 2
        ;;
esac

if [ "$linking" = false ]; then
    position_independent=-fPIE
    if [ "$output_kind" = shared ]; then
        position_independent=-fPIC
    fi
    exec "$compiler" \
        --target="$target" $architecture_flags \
        --sysroot="$sysroot" -isystem "$sysroot/include" \
        -ffreestanding \
        "$position_independent" \
        -ffunction-sections \
        -fdata-sections \
        -fvisibility=hidden \
        -fno-stack-protector \
        "$@"
fi

linker=${HYPER_LD:-}
if [ -n "$linker" ]; then
    linker_option=--ld-path="$linker"
else
    linker_option=-fuse-ld=lld
fi
linker_script=$sysroot/lib/hyper/$architecture/hyper-native.ld
crt=$sysroot/lib/crt1.o
crt_support=$sysroot/lib/crt.o
brand=$sysroot/bin/hyper-brand-elf
for required in "$linker_script" "$crt" "$crt_support" "$brand"; do
    if [ ! -f "$required" ]; then
        echo "hyper-clang: incomplete Native sysroot: $required" >&2
        exit 2
    fi
done

if [ "$output_kind" = shared ]; then
    if [ "$link_mode" = static ]; then
        echo "hyper-clang: static shared objects are unsupported" >&2
        exit 2
    fi
    "$compiler" \
        --target="$target" $architecture_flags --sysroot="$sysroot" -isystem "$sysroot/include" "$linker_option" $architecture_link_flags \
        -Wno-unused-command-line-argument -ffreestanding -fPIC \
        -ffunction-sections -fdata-sections -fvisibility=hidden \
        -fno-stack-protector -nostdlib "$@" \
        -Wl,-shared,--no-undefined,--fatal-warnings,-z,text,-z,relro,-z,now \
        -Wl,--build-id=none,--gc-sections,-z,noexecstack,-z,max-page-size=4096 \
        -Wl,--hash-style=sysv,--as-needed,--entry=0 \
        -L"$sysroot/lib" -Wl,-Bdynamic -lhyper
elif [ "$link_mode" = static ]; then
    "$compiler" \
        --target="$target" $architecture_flags --sysroot="$sysroot" -isystem "$sysroot/include" "$linker_option" $architecture_link_flags \
        -Wno-unused-command-line-argument -ffreestanding -fPIE \
        -ffunction-sections -fdata-sections -fvisibility=hidden \
        -fno-stack-protector -nostdlib "$crt" "$crt_support" "$@" \
        -Wl,-static,-pie,--no-dynamic-linker,--no-undefined,--fatal-warnings \
        -Wl,-Bsymbolic,-z,text,--entry=_start \
        -Wl,--build-id=none,--gc-sections,-z,noexecstack,-z,max-page-size=4096 \
        -Wl,-T,"$linker_script" -L"$sysroot/lib" -lhyper
elif [ "$link_mode" = dynamic ]; then
    "$compiler" \
        --target="$target" $architecture_flags --sysroot="$sysroot" -isystem "$sysroot/include" "$linker_option" $architecture_link_flags \
        -Wno-unused-command-line-argument -ffreestanding -fPIE \
        -ffunction-sections -fdata-sections -fvisibility=hidden \
        -fno-stack-protector -nostdlib "$crt" "$crt_support" "$@" \
        "-Wl,-pie,--dynamic-linker=/lib64/ld-hyper-$architecture.so" \
        -Wl,--no-undefined,--fatal-warnings,-z,text,-z,relro,-z,now \
        -Wl,--build-id=none,--gc-sections,-z,noexecstack,-z,max-page-size=4096 \
        -Wl,--hash-style=sysv,--entry=_start,--as-needed \
        -L"$sysroot/lib" -Wl,-Bdynamic -lhyper
else
    echo "hyper-clang: HYPER_LINK_MODE must be dynamic or static" >&2
    exit 2
fi
"$brand" "$output"
if [ "$static_only" = true ] || [ "$link_mode" = static ]; then
    # Inspect the result, not just driver flags: -Wl/response-file options must
    # not accidentally introduce an interpreter or a DT_NEEDED dependency.
    if ! "$brand" --check-static "$output"; then
        rm -f -- "$output"
        exit 1
    fi
fi
